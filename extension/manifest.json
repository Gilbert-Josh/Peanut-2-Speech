{
  "manifest_version": 3,
  "name": "Peanut 2 Speech",
  "version": "0.1.0",
  "description": "A local Speechify-style reader powered by your Text-to-speech Kokoro engine.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Peanut 2 Speech"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-reader": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Open Peanut 2 Speech"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "peanut-2-speech@gilbert-josh.local"
    }
  },
  "sidebar_action": {
    "default_title": "Peanut 2 Speech",
    "default_panel": "sidepanel.html"
  }
}
